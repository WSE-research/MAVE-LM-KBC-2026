# Only needed to draw NEW responses (run.py --live).
# Reproducing the published numbers replays cache/ and needs none of this.
#
# Copy to .env and fill in. Any OpenAI-compatible endpoint works.

# --- a local server (vLLM, Ollama, llama.cpp, LM Studio, TGI …) ---
# MAVE_BASE_URL=http://localhost:8000/v1
# MAVE_API_KEY=not-needed-but-must-be-set
# then: python run.py --split val --live --model mistralai/Mistral-Small-3.2-24B-Instruct-2506

# --- a hosted OpenAI-compatible provider ---
# MAVE_BASE_URL=https://openrouter.ai/api/v1
# MAVE_API_KEY=sk-...

# OPENAI_BASE_URL / OPENAI_API_KEY / OPENROUTER_API_KEY are read as fallbacks,
# so an environment already configured for one of those works unchanged.
